---
// Página de inicio: aquí se ensamblan las secciones en orden.
import Base from '../layouts/Base.astro';
import BarraAnuncio from '../components/BarraAnuncio.astro';
import Encabezado from '../components/Encabezado.astro';
---
<Base>
  <BarraAnuncio />
  <Encabezado />
  <main>
    <!-- Paso 2: Hero (pendiente de aprobación del paso 1) -->
    <section class="pendiente contenedor" aria-label="Próximas secciones">
      <p>Aquí irá el Hero (paso 2).</p>
    </section>
  </main>
</Base>

<style>
  .pendiente {
    display: grid;
    place-items: center;
    min-height: 160vh;   /* alto temporal para poder probar el encabezado al hacer scroll */
    font-size: var(--t-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.35;
    align-items: start;
    padding-block: var(--e-9);
  }
</style>
