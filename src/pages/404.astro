---
// Página para enlaces rotos. Cloudflare Pages la muestra sola cuando una dirección no existe.
import Tienda from '../layouts/Tienda.astro';
import paginas from '../data/paginas.json';
import nav from '../data/navegacion.json';

const t = paginas.error;
---
<Tienda titulo={t.titulo} indexar={false}>
  <section class="error relleno" aria-labelledby="error-titulo">
    <p class="error__numero" aria-hidden="true">404</p>
    <h1 class="error__titulo" id="error-titulo">{t.titulo}</h1>
    <p class="error__frase">{t.frase}</p>
    <div class="error__botones">
      <a class="boton" href="/">Volver al inicio</a>
      <a class="boton boton--borde" href="/buscar">Buscar una pieza</a>
    </div>
    <ul class="error__menu" role="list">
      {nav.menu.map((m) => <li><a href={m.enlace}>{m.texto}</a></li>)}
    </ul>
  </section>
</Tienda>

<style>
  .error { display: grid; gap: var(--e-4); justify-items: start; padding-block: var(--e-7) var(--e-8); }
  .error__numero { font-family: var(--f-display); font-stretch: var(--ancho-display); font-weight: var(--peso-display); font-size: clamp(6rem, 2rem + 18vw, 16rem); line-height: 0.8; -webkit-text-stroke: 2px var(--noche); color: transparent; }
  .error__titulo { font-size: var(--t-2xl); }
  .error__frase { font-size: var(--t-md); max-width: 40ch; }
  .error__botones { display: flex; flex-wrap: wrap; gap: var(--e-2); }
  .error__menu { display: flex; flex-wrap: wrap; gap: var(--e-2) var(--e-4); margin: var(--e-4) 0 0; padding: var(--e-4) 0 0; border-top: var(--borde); list-style: none; font-weight: var(--peso-medio); }
</style>
