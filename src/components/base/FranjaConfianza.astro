---
// Franja de confianza: garantía, cambios, envío y métodos de pago (textos en src/data/confianza.json).
// Banda con líneas arriba y abajo, sin caja redondeada.
import datos from '../../data/confianza.json';
interface Props { compacta?: boolean; oscura?: boolean }
const { compacta = false, oscura = false } = Astro.props;
---
<ul class:list={['confianza', { 'confianza--compacta': compacta, 'confianza--oscura sobre-oscuro': oscura }]} role="list">
  {datos.items.map((i) => (
    <li class="confianza__item">
      <p class="confianza__titulo">{i.titulo}</p>
      {!compacta && <p class="confianza__texto">{i.texto}</p>}
    </li>
  ))}
</ul>

<style>
  .confianza {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--borde-fuerte);
    border-bottom: var(--borde-fuerte);
  }
  .confianza__item { padding: var(--e-4) var(--e-3); min-width: 0; }
  .confianza__item:nth-child(odd) { border-right: var(--borde); }
  .confianza__item:nth-child(-n + 2) { border-bottom: var(--borde); }
  .confianza__titulo { font-weight: var(--peso-boton); font-size: var(--t-sm); line-height: 1.3; }
  .confianza__texto { margin-top: var(--e-1); font-size: var(--t-sm); color: var(--texto-suave); line-height: 1.4; }
  .confianza--compacta .confianza__item { padding: var(--e-3) var(--e-2); }
  .confianza--oscura { background: var(--profundo); color: var(--hueso); border-color: var(--hueso); }
  .confianza--oscura .confianza__texto { color: var(--hueso-70); }
  .confianza--oscura .confianza__item { border-color: var(--hueso-linea); }
  @media (min-width: 900px) {
    .confianza:not(.confianza--compacta) { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .confianza:not(.confianza--compacta) .confianza__item { border-bottom: 0; border-right: var(--borde); padding: var(--e-5); }
    .confianza:not(.confianza--compacta) .confianza__item:last-child { border-right: 0; }
  }
</style>
