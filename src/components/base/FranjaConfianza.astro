---
// Franja de confianza: garantía, cambios, envío y métodos de pago (textos en src/data/confianza.json).
import Estrella from './Estrella.astro';
import datos from '../../data/confianza.json';
interface Props { compacta?: boolean; oscura?: boolean }
const { compacta = false, oscura = false } = Astro.props;
---
<ul class:list={['confianza', { 'confianza--compacta': compacta, 'confianza--oscura sobre-oscuro': oscura }]} role="list">
  {datos.items.map((i) => (
    <li class="confianza__item">
      <Estrella tamano="0.85rem" clase="confianza__estrella" />
      <div>
        <p class="confianza__titulo">{i.titulo}</p>
        {!compacta && <p class="confianza__texto">{i.texto}</p>}
      </div>
    </li>
  ))}
</ul>

<style>
  .confianza {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e-5) var(--e-4);
    margin: 0;
    padding: var(--e-5);
    list-style: none;
    border: var(--borde);
    border-radius: var(--r-tarjeta);
  }
  .confianza__item { display: flex; align-items: flex-start; gap: var(--e-2); min-width: 0; }
  .confianza__item :global(.confianza__estrella) { margin-top: 0.3em; }
  .confianza__titulo { font-weight: var(--peso-boton); font-size: var(--t-sm); line-height: 1.3; }
  .confianza__texto { margin-top: var(--e-1); font-size: var(--t-sm); color: var(--texto-suave); line-height: 1.4; }
  .confianza--compacta { gap: var(--e-3); padding: var(--e-4); border-radius: var(--r-chico); }
  .confianza--oscura { background: var(--profundo); color: var(--hueso); border-color: transparent; }
  .confianza--oscura .confianza__texto { color: var(--hueso-70); }
  .confianza--oscura :global(.confianza__estrella) { color: var(--perla); }
  @media (min-width: 900px) {
    .confianza:not(.confianza--compacta) { grid-template-columns: repeat(4, minmax(0, 1fr)); padding: var(--e-6); }
  }
</style>
