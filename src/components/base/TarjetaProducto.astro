---
// Tarjeta de producto estilo Studs: foto cuadrada de borde a borde, esquinas rectas,
// etiqueta tipo sticker, "Agregar +" sobre la foto y datos debajo.
import Foto from './Foto.astro';
import Etiqueta from './Etiqueta.astro';
import Precio from './Precio.astro';
import PuntosMetal from './PuntosMetal.astro';
import { precioDe, nombreMetal, type Producto } from '../../lib/productos';

interface Props { producto: Producto; prioridad?: boolean; metal?: string }
const { producto: p, prioridad = false, metal: metalPedido } = Astro.props;
// Si piden un metal que la pieza tiene, se muestra ese; si no, el primero
const metal = (metalPedido && (p.metales as string[]).includes(metalPedido) ? metalPedido : p.metales[0]) as Producto['metales'][number];
const precio = precioDe(p, metal);
const foto = p.fotos[0];
const fotoPuesta = p.fotos[1];
const url = metal === p.metales[0] ? `/producto/${p.slug}` : `/producto/${p.slug}?metal=${metal}`;
---
<article
  class="tarjeta"
  data-tarjeta
  data-slug={p.slug}
  data-sub={p.subcategoria}
  data-metales={p.metales.join(' ')}
  data-precios={JSON.stringify(p.precios)}
>
  <div class="tarjeta__foto">
    <a href={url} tabindex="-1" aria-hidden="true" data-enlace-tarjeta>
      <Foto src={foto?.src} alt="" nota={foto?.nota} proporcion="1 / 1" prioridad={prioridad} />
      {fotoPuesta && (
        <span class="tarjeta__foto-puesta">
          <Foto src={fotoPuesta.src} alt="" nota={fotoPuesta.nota} proporcion="1 / 1" />
        </span>
      )}
    </a>
    <div class="tarjeta__sellos">
      {p.etiquetas.map((t) => <Etiqueta texto={t} />)}
      {p.placeholder && <Etiqueta texto="Ejemplo" variante="suave" />}
    </div>
    <button
      class="boton boton--chico tarjeta__agregar"
      type="button"
      data-agregar
      data-slug={p.slug}
      data-nombre={p.nombre}
      data-metal={metal}
      data-precio={precio}
      aria-label={`Agregar ${p.nombre} en ${nombreMetal(metal)} a la bolsa`}
    >Agregar +</button>
  </div>

  <div class="tarjeta__info">
    <h3 class="tarjeta__nombre"><a href={url} data-enlace-tarjeta>{p.nombre}</a></h3>
    <div class="tarjeta__fila">
      <Precio valor={precio} />
      <PuntosMetal metales={p.metales} />
    </div>
  </div>
</article>

<style>
  .tarjeta { display: grid; align-content: start; min-width: 0; background: var(--hueso); }
  .tarjeta__foto { position: relative; overflow: hidden; }
  .tarjeta__foto > a { display: block; text-decoration: none; }
  /* La nota de la foto va arriba, debajo de las etiquetas, para no chocar con el botón */
  .tarjeta__foto :global(.foto__marcador) { align-items: flex-start; padding-top: 38px; }
  .tarjeta__foto :global(.foto img) { transition: transform 0.6s var(--suave); }
  .tarjeta:hover .tarjeta__foto :global(.foto img) { transform: scale(1.03); }
  /* En computador, al pasar el mouse se ve la joya puesta */
  .tarjeta__foto-puesta { position: absolute; inset: 0; opacity: 0; transition: opacity var(--medio) var(--suave); }
  @media (hover: hover) { .tarjeta:hover .tarjeta__foto-puesta { opacity: 1; } }

  .tarjeta__sellos {
    position: absolute;
    top: var(--e-2);
    left: var(--e-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1);
    pointer-events: none;
  }
  .tarjeta__agregar {
    position: absolute;
    right: var(--e-2);
    bottom: var(--e-2);
    min-height: 36px;
    padding-inline: var(--e-3);
    font-size: 0.8125rem;
  }
  .tarjeta__info { display: grid; gap: var(--e-1); padding: var(--e-3) var(--e-3) var(--e-4); }
  .tarjeta__nombre { font-size: var(--t-sm); font-weight: var(--peso-medio); line-height: 1.3; }
  .tarjeta__nombre a { text-decoration: none; }
  .tarjeta__nombre a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .tarjeta__fila { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--e-2); font-size: var(--t-sm); }

  @media (min-width: 900px) {
    .tarjeta__agregar { opacity: 0; transform: translateY(6px); transition: opacity var(--rapido), transform var(--rapido); }
    .tarjeta:hover .tarjeta__agregar,
    .tarjeta__agregar:focus-visible { opacity: 1; transform: none; }
  }
  @media (hover: none) { .tarjeta__agregar { opacity: 1 !important; transform: none !important; } }
</style>
