---
// Logo de Perpetuo. NUNCA se redibuja: usa el archivo original de /public/logos.
// Busca las variantes en el orden indicado y usa la primera que exista.
// Si no hay ninguna, muestra un espacio marcado.
import fs from 'node:fs';
import path from 'node:path';

type Variante = 'horizontal' | 'monograma';
interface Props { variantes?: Variante[]; clase?: string }
const { variantes = ['horizontal', 'monograma'], clase = '' } = Astro.props;

const extensiones = ['svg', 'png', 'webp'];
let ruta: string | null = null;
let usada: Variante = variantes[0];
for (const v of variantes) {
  const ext = extensiones.find((e) =>
    fs.existsSync(path.join(process.cwd(), 'public', 'logos', `perpetuo-${v}.${e}`)),
  );
  if (ext) { ruta = `/logos/perpetuo-${v}.${ext}`; usada = v; break; }
}
---
{ruta ? (
  <img class:list={['logo', `logo--${usada}`, clase]} src={ruta} alt="Perpetuo Joyería" />
) : (
  <span class:list={['logo', 'logo--espacio', clase]} role="img" aria-label="Perpetuo Joyería">
    <span>Logo {variantes[0]}</span>
    <small>/logos/perpetuo-{variantes[0]}.svg</small>
  </span>
)}

<style>
  /* El alto lo decide cada sección con --alto-logo; el ancho se ajusta solo */
  .logo { height: var(--alto-logo, 36px); width: auto; }
  .logo--horizontal { max-width: min(180px, 44vw); object-fit: contain; }
  .logo--espacio {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4.5 / 1;
    max-width: 100%;
    border: 1px dashed var(--noche);
    border-radius: 6px;
    font-family: var(--f-texto);
    font-size: 0.6rem;
    line-height: 1.15;
    letter-spacing: 0.02em;
    color: var(--noche);
    background: repeating-linear-gradient(135deg, transparent 0 6px, var(--linea-suave) 6px 7px);
  }
  .logo--espacio small {
    font-size: 0.5rem;
    letter-spacing: 0.04em;
    text-transform: none;
    opacity: 0.7;
  }
  @media (min-width: 1024px) { .logo--horizontal { max-width: 260px; } }
</style>
