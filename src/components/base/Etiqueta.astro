---
// Etiqueta pequeña: "Favorito", "Nuevo", "Del mes"…
// destacada = Amarillo Perla (lo especial) · suave = contorno · oscura = Azul Profundo
interface Props { texto: string; variante?: 'destacada' | 'suave' | 'oscura'; clase?: string }
const { texto, variante = 'destacada', clase = '' } = Astro.props;
---
<span class:list={['etiqueta', `etiqueta--${variante}`, clase]}>{texto}</span>

<style>
  .etiqueta {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    padding: 0 var(--e-2);
    border-radius: var(--r-etiqueta);
    font-size: 0.6875rem;
    font-weight: var(--peso-boton);
    letter-spacing: var(--espaciado-etiqueta);
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
  .etiqueta--destacada { background: var(--perla); color: var(--noche); border: 1px solid var(--noche); }
  .etiqueta--suave { background: var(--hueso); color: var(--noche); border: 1px solid var(--linea); }
  .etiqueta--oscura { background: var(--profundo); color: var(--hueso); }
</style>
