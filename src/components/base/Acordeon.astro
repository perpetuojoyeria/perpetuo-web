---
// Acordeón (envío, cambios, garantía, preguntas). Usa <details>: funciona sin JavaScript.
interface Props { titulo: string; abierto?: boolean }
const { titulo, abierto = false } = Astro.props;
---
<details class="acordeon" open={abierto}>
  <summary class="acordeon__titulo">
    <span>{titulo}</span>
    <span class="acordeon__signo" aria-hidden="true"></span>
  </summary>
  <div class="acordeon__contenido"><slot /></div>
</details>

<style>
  .acordeon { border-bottom: var(--borde); }
  .acordeon__titulo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    min-height: 56px;
    padding-block: var(--e-3);
    font-weight: var(--peso-medio);
    cursor: pointer;
    list-style: none;
  }
  .acordeon__titulo::-webkit-details-marker { display: none; }
  .acordeon__signo { position: relative; flex: none; width: 14px; height: 14px; }
  .acordeon__signo::before,
  .acordeon__signo::after {
    content: '';
    position: absolute;
    top: 50%; left: 0;
    width: 100%; height: 1.5px;
    background: currentColor;
    transition: transform var(--medio) var(--suave);
  }
  .acordeon__signo::after { transform: rotate(90deg); }
  .acordeon[open] .acordeon__signo::after { transform: rotate(0deg); }
  .acordeon__contenido { padding-bottom: var(--e-5); color: var(--texto-suave); max-width: var(--ancho-texto); }
</style>
