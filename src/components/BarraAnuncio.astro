---
// PASO 1a · Barra de anuncio
// Franja delgada en Amarillo Perla con frases que rotan.
// Las frases se editan en src/data/anuncios.json (sin tocar este archivo).
import datos from '../data/anuncios.json';
const { frases, segundosPorFrase } = datos;
---
<aside class="anuncio" aria-label="Anuncios" data-intervalo={segundosPorFrase * 1000}>
  <div class="anuncio__marco">
    <ul class="anuncio__lista" role="list">
      {frases.map((f, i) => (
        <li class:list={['anuncio__frase', { 'es-visible': i === 0 }]} aria-hidden={i === 0 ? 'false' : 'true'}>
          <span>{f.texto}</span>
          {f.guino && <em class="anuncio__guino">{f.guino}</em>}
          {f.enlace && (
            <a class="anuncio__enlace" href={f.enlace} tabindex={i === 0 ? undefined : '-1'}>
              {f.textoEnlace ?? 'Ver más'}
            </a>
          )}
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .anuncio {
    background: var(--perla);
    color: var(--noche);
    border-bottom: 1px solid var(--linea-suave);
  }
  .anuncio__marco {
    max-width: var(--ancho-max);
    margin-inline: auto;
    padding-left: var(--margen);
    padding-right: var(--margen-der);
  }
  .anuncio__lista {
    position: relative;
    display: grid;          /* todas las frases ocupan la misma celda: no salta la altura */
    margin: 0;
    padding: 0;
    list-style: none;
    min-height: 36px;
  }
  .anuncio__frase {
    grid-area: 1 / 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: 0.5em;
    padding-block: 0.45rem;
    text-align: center;
    font-family: var(--f-texto);
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    line-height: 1.35;
    opacity: 0;
    transform: translateY(6px);
    visibility: hidden;
    transition: opacity 0.6s var(--suave), transform 0.6s var(--suave), visibility 0s linear 0.6s;
  }
  .anuncio__frase.es-visible {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition: opacity 0.6s var(--suave), transform 0.6s var(--suave), visibility 0s;
  }
  .anuncio__guino {
    font-family: var(--f-coqueta);
    font-style: italic;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
  }
  .anuncio__enlace {
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  @media (min-width: 768px) {
    .anuncio__frase { font-size: 0.8rem; }
  }
</style>

<script>
  // Rota las frases. Se pausa si la usuaria pasa el dedo/mouse encima o enfoca un enlace,
  // y cuando la pestaña no está visible (no gasta batería).
  document.querySelectorAll<HTMLElement>('.anuncio').forEach((barra) => {
    const frases = Array.from(barra.querySelectorAll<HTMLElement>('.anuncio__frase'));
    if (frases.length < 2) return;
    const intervalo = Number(barra.dataset.intervalo) || 4500;
    let actual = 0;
    let pausado = false;

    const mostrar = (n: number) => {
      frases.forEach((f, i) => {
        const visible = i === n;
        f.classList.toggle('es-visible', visible);
        f.setAttribute('aria-hidden', visible ? 'false' : 'true');
        f.querySelectorAll('a').forEach((a) => (visible ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
    };

    setInterval(() => {
      if (pausado || document.hidden) return;
      actual = (actual + 1) % frases.length;
      mostrar(actual);
    }, intervalo);

    barra.addEventListener('pointerenter', () => (pausado = true));
    barra.addEventListener('pointerleave', () => (pausado = false));
    barra.addEventListener('focusin', () => (pausado = true));
    barra.addEventListener('focusout', () => (pausado = false));
  });
</script>
