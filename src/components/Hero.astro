---
// PASO 2 · Hero con video
// Celular: video vertical a todo el ancho con el texto encima.
// Computador: bloque Azul Noche con el texto a la izquierda y el video a la derecha (estilo portada).
// Textos y nombres del video se editan en src/data/hero.json.
import fs from 'node:fs';
import path from 'node:path';
import hero from '../data/hero.json';

const existe = (ruta: string) => fs.existsSync(path.join(process.cwd(), 'public', ruta));
const { video } = hero;
const hayVideo = existe(video.mp4);
const hayWebm = existe(video.webm);
const hayPoster = existe(video.poster);
---
<section class="hero sobre-oscuro" aria-labelledby="hero-titulo">
  <div class="hero__medio">
    {hayVideo ? (
      <video
        class="hero__video"
        muted
        loop
        playsinline
        preload="metadata"
        poster={hayPoster ? video.poster : undefined}
        aria-label={video.descripcionAccesible}
        data-hero-video
      >
        {hayWebm && <source src={video.webm} type="video/webm" />}
        <source src={video.mp4} type="video/mp4" />
      </video>
    ) : (
      <div class="hero__marcador" role="img" aria-label={video.descripcionAccesible}>
        <span class="hero__marcador-etiqueta">{hero.marcador}</span>
      </div>
    )}

    {hayVideo && (
      <button class="hero__pausa" type="button" aria-label="Pausar video" data-hero-pausa>
        <svg class="icono-pausa" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect x="2.5" y="1.5" width="3" height="11" rx="1" fill="currentColor"/><rect x="8.5" y="1.5" width="3" height="11" rx="1" fill="currentColor"/></svg>
        <svg class="icono-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3.5 1.8v10.4a.6.6 0 0 0 .9.5l8.2-5.2a.6.6 0 0 0 0-1L4.4 1.3a.6.6 0 0 0-.9.5Z" fill="currentColor"/></svg>
      </button>
    )}
  </div>

  <div class="hero__texto">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="hero__titulo" id="hero-titulo">{hero.titulo}</h1>
    <p class="hero__frase">{hero.frase}</p>
    <div class="hero__botones">
      <a class="boton boton--claro" href={hero.botonPrincipal.enlace}>{hero.botonPrincipal.texto}</a>
      <a class="boton boton--borde-claro" href={hero.botonSecundario.enlace}>{hero.botonSecundario.texto}</a>
    </div>
  </div>
</section>

<style>
  /* ——— Celular: video a todo el ancho, texto encima ——— */
  .hero {
    position: relative;
    display: grid;
    background: var(--profundo);
    color: var(--hueso);
    overflow: hidden;
  }
  .hero__medio,
  .hero__texto { grid-area: 1 / 1; }   /* misma celda: el texto queda sobre el video */

  .hero__medio {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 82svh;
    width: 100%;
    max-width: 100%;
  }
  .hero__video,
  .hero__marcador {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Velo inferior para que el texto siempre se lea sobre el video */
  .hero__medio::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(35 42 68 / 0.92) 0%, rgb(35 42 68 / 0.55) 38%, transparent 68%);
    pointer-events: none;
  }

  /* Marcador mientras no hay video */
  .hero__marcador {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: var(--e-5) var(--e-5) var(--e-5);
    background:
      radial-gradient(120% 70% at 70% 20%, rgb(255 253 203 / 0.16), transparent 60%),
      linear-gradient(160deg, var(--noche), var(--profundo));
  }
  .hero__marcador-etiqueta {
    max-width: 30ch;
    margin-right: 44px;   /* deja libre la esquina del botón de pausa */
    padding: var(--e-3) var(--e-4);
    border: 1px dashed rgb(251 251 244 / 0.5);
    border-radius: 12px;
    font-size: 0.65rem;
    line-height: 1.45;
    letter-spacing: 0.04em;
    text-align: center;
    color: rgb(251 251 244 / 0.85);
  }

  .hero__pausa {
    position: absolute;
    top: var(--e-4);
    right: max(var(--e-4), env(safe-area-inset-right, 0px));
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(251 251 244 / 0.5);
    border-radius: var(--r-pildora);
    background: rgb(35 42 68 / 0.35);
    color: var(--hueso);
    cursor: pointer;
    backdrop-filter: blur(6px);
  }
  .hero__pausa .icono-play { display: none; }
  .hero__pausa[data-pausado] .icono-play { display: block; }
  .hero__pausa[data-pausado] .icono-pausa { display: none; }

  .hero__texto {
    position: relative;
    z-index: 1;
    align-self: end;
    display: grid;
    gap: var(--e-3);
    justify-items: start;
    padding-block: var(--e-6) var(--e-5);
    padding-left: var(--margen);
    padding-right: var(--margen-der);
  }
  .hero__eyebrow {
    margin: 0;
    font-size: var(--t-xs);
    font-weight: 500;
    letter-spacing: var(--espaciado-titulo);
    text-transform: uppercase;
    color: var(--perla);
  }
  .hero__titulo {
    margin: 0;
    font-family: var(--f-titulo);
    font-weight: 400;
    font-size: clamp(2.1rem, 1.2rem + 5vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .hero__frase {
    margin: 0;
    font-family: var(--f-coqueta);
    font-style: italic;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
    line-height: 1.25;
  }
  .hero__botones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-top: var(--e-3);
  }
  .hero__botones { align-items: center; column-gap: var(--e-5); }
  .hero__botones .boton { padding-inline: var(--e-5); }
  /* En celular el segundo botón es un enlace subrayado: ocupa menos y deja ver el video */
  @media (max-width: 899px) {
    .hero__botones .boton--borde-claro {
      min-height: 44px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      text-decoration: underline;
      text-underline-offset: 6px;
      text-decoration-thickness: 1px;
    }
    .hero__botones .boton--borde-claro:hover { background: none; color: var(--perla); }
  }

  /* Entrada suave del texto (una sola vez, al cargar) */
  @media (prefers-reduced-motion: no-preference) {
    .hero__texto > * { animation: subir 0.9s var(--suave) both; }
    .hero__titulo { animation-delay: 0.08s; }
    .hero__frase { animation-delay: 0.18s; }
    .hero__botones { animation-delay: 0.28s; }
  }
  @keyframes subir { from { opacity: 0.001; transform: translateY(14px); } }

  /* ——— Computador: bloque de color + video, estilo portada ——— */
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      background: var(--noche);
    }
    .hero__texto {
      grid-area: 1 / 1;
      align-self: center;
      gap: var(--e-4);
      padding: var(--e-8) clamp(2rem, 5vw, 5rem);
      padding-left: max(clamp(2rem, 5vw, 5rem), env(safe-area-inset-left, 0px));
    }
    .hero__medio {
      grid-area: 1 / 2;
      aspect-ratio: auto;
      height: clamp(520px, 78vh, 760px);
      max-height: none;
    }
    .hero__medio::after { display: none; }
    .hero__pausa { top: auto; bottom: var(--e-5); right: var(--e-5); }
    .hero__marcador { align-items: center; }
    .hero__marcador-etiqueta { font-size: 0.8rem; }
  }
</style>

<script>
  // Reproduce el video solo si conviene: no con "reducir movimiento" ni con ahorro de datos,
  // y lo pausa cuando sale de la pantalla para no gastar batería.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const boton = document.querySelector<HTMLButtonElement>('[data-hero-pausa]');

  if (video && boton) {
    const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ahorro = (navigator as any).connection?.saveData === true;
    let pausadoPorUsuaria = reducir || ahorro;

    const pintar = () => {
      const pausado = video.paused;
      boton.toggleAttribute('data-pausado', pausado);
      boton.setAttribute('aria-label', pausado ? 'Reproducir video' : 'Pausar video');
    };
    const reproducir = () => video.play().catch(() => {}).finally(pintar);

    if (!pausadoPorUsuaria) reproducir(); else pintar();

    boton.addEventListener('click', () => {
      if (video.paused) { pausadoPorUsuaria = false; reproducir(); }
      else { pausadoPorUsuaria = true; video.pause(); pintar(); }
    });

    new IntersectionObserver(([e]) => {
      if (pausadoPorUsuaria) return;
      if (e.isIntersecting) reproducir(); else { video.pause(); pintar(); }
    }, { threshold: 0.25 }).observe(video);
  }
</script>
