---
// Encabezado: logo, menú, buscador, cuenta y bolsa. En celular el menú se vuelve hamburguesa.
// Las opciones del menú se editan en src/data/navegacion.json.
import Logo from '../base/Logo.astro';
import Etiqueta from '../base/Etiqueta.astro';
import nav from '../../data/navegacion.json';
import sitio from '../../data/sitio.json';
const rutaActual = Astro.url.pathname;
---
<header class="encabezado" data-encabezado>
  <div class="encabezado__fila contenedor">
    <div class="encabezado__lado">
      <button class="icono solo-movil" type="button" aria-label="Abrir menú" aria-haspopup="dialog" data-abrir-menu>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h18M3 16h12" stroke-linecap="round"/></svg>
      </button>
      <button class="icono icono--buscar" type="button" aria-label="Buscar" aria-expanded="false" aria-controls="panel-busqueda" data-abrir-busqueda>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5" stroke-linecap="round"/></svg>
        <span class="icono__texto">Buscar</span>
      </button>
    </div>

    <a class="encabezado__logo" href="/" aria-label={`${sitio.nombre}, ir al inicio`}>
      <Logo />
    </a>

    <div class="encabezado__lado encabezado__lado--der">
      <a class="icono" href={nav.cuenta} aria-label="Mi cuenta">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8.5" r="4"/><path d="M4 20.5c1.3-3.6 4.4-5.5 8-5.5s6.7 1.9 8 5.5" stroke-linecap="round"/></svg>
      </a>
      <a class="icono icono--bolsa" href={nav.bolsa} aria-label="Bolsa de compras" data-enlace-bolsa>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 8h14l-1 12.5H6L5 8Z" stroke-linejoin="round"/><path d="M9 10.5V7a3 3 0 0 1 6 0v3.5" stroke-linecap="round"/></svg>
        <span class="bolsa__cuenta" data-cuenta-bolsa hidden>0</span>
      </a>
    </div>
  </div>

  <nav class="menu solo-escritorio contenedor" aria-label="Principal">
    <ul role="list">
      {nav.menu.map((item) => (
        <li>
          <a href={item.enlace} class="menu__enlace" aria-current={rutaActual.startsWith(item.enlace) ? 'page' : undefined}>
            {item.texto}
            {item.etiqueta && <Etiqueta texto={item.etiqueta} />}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="busqueda" id="panel-busqueda" hidden>
    <form class="busqueda__form contenedor" action={nav.buscar} method="get" role="search">
      <label class="solo-lector" for="campo-busqueda">¿Qué brillo buscas?</label>
      <input id="campo-busqueda" name="q" type="search" placeholder="Argollas, cadenas, ear cuffs…" autocomplete="off" />
      <button class="boton boton--oscuro" type="submit">Buscar</button>
    </form>
  </div>
</header>

<dialog class="cajon" aria-label="Menú" data-cajon>
  <div class="cajon__interior">
    <div class="cajon__cabeza">
      <span class="cajon__rotulo">Menú</span>
      <button class="icono" type="button" aria-label="Cerrar menú" data-cerrar-menu>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" stroke-linecap="round"/></svg>
      </button>
    </div>
    <nav aria-label="Principal (celular)">
      <ul class="cajon__lista" role="list">
        {nav.menu.map((item) => (
          <li>
            <a href={item.enlace} class="cajon__enlace">
              <span class="cajon__nombre">{item.texto}</span>
              {item.etiqueta ? <Etiqueta texto={item.etiqueta} /> : <span class="cajon__nota">{item.nota}</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="cajon__pie">
      <a class="boton boton--borde" href={nav.cuenta}>Mi cuenta</a>
      <p class="cajon__tagline">{sitio.tagline}</p>
    </div>
  </div>
</dialog>

<style>
  .encabezado {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: var(--z-encabezado);
    background: var(--hueso);
    border-bottom: 1px solid var(--linea);
    transition: border-color var(--medio) var(--suave), box-shadow var(--medio) var(--suave);
  }
  .encabezado.con-sombra { border-bottom-color: var(--noche); }
  .encabezado__fila {
    display: grid;
    grid-template-columns: 1fr auto 1fr;   /* el logo siempre queda al centro */
    align-items: center;
    min-height: 60px;
  }
  .encabezado__lado { display: flex; align-items: center; gap: var(--e-1); }
  .encabezado__lado--der { justify-content: flex-end; }
  .encabezado__logo {
    --alto-logo: 44px;
    display: flex;
    justify-content: center;
    padding-block: var(--e-2);
    text-decoration: none;
  }
  .encabezado__logo :global(.logo) { transition: height var(--medio) var(--suave); }

  .icono {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    min-width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--r-pildora);
    background: transparent;
    color: var(--noche);
    cursor: pointer;
    text-decoration: none;
    transition: background var(--rapido) var(--suave);
  }
  .icono:hover { background: var(--linea-suave); }
  .icono__texto { display: none; }
  .bolsa__cuenta {
    position: absolute;
    top: 4px;
    right: 2px;
    display: grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border: 1px solid var(--noche);
    border-radius: var(--r-pildora);
    background: var(--perla);
    font-size: 0.6875rem;
    font-weight: var(--peso-boton);
    line-height: 1;
  }

  /* Menú de escritorio */
  .menu ul {
    display: flex;
    justify-content: center;
    gap: clamp(1.25rem, 2.6vw, 2.5rem);
    margin: 0;
    padding: 0 0 var(--e-3);
    list-style: none;
  }
  .menu__enlace {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    padding: var(--e-1) 0;
    font-size: 0.9375rem;
    font-weight: var(--peso-boton);
    text-decoration: none;
  }
  .menu__enlace::after {
    content: '';
    position: absolute;
    left: 0; right: 100%; bottom: -2px;
    height: 2px;
    background: currentColor;
    transition: right var(--medio) var(--suave);
  }
  .menu__enlace:hover::after,
  .menu__enlace[aria-current='page']::after { right: 0; }

  /* Búsqueda */
  .busqueda { border-top: var(--borde); background: var(--hueso); padding-block: var(--e-4); }
  .busqueda__form { display: flex; gap: var(--e-2); }
  .busqueda input {
    flex: 1;
    min-width: 0;
    height: 48px;
    padding: 0 var(--e-5);
    border: var(--borde);
    border-radius: var(--r-pildora);
    background: var(--hueso);
    font-size: var(--t-base);   /* 16px: evita el zoom del iPhone */
  }
  .busqueda input::placeholder { color: var(--texto-suave); }
  .busqueda input:focus { outline: none; border-color: var(--noche); }

  /* Cajón (menú de celular) */
  .cajon {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: var(--z-cajon);
    width: min(88vw, 400px);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--hueso);
    color: var(--noche);
    transform: translateX(-100%);
    transition: transform 0.45s var(--suave), overlay 0.45s allow-discrete, display 0.45s allow-discrete;
  }
  .cajon[open] { transform: none; }
  @starting-style { .cajon[open] { transform: translateX(-100%); } }
  .cajon::backdrop {
    background: var(--velo);
    opacity: 0;
    transition: opacity 0.45s var(--suave), overlay 0.45s allow-discrete, display 0.45s allow-discrete;
  }
  .cajon[open]::backdrop { opacity: 1; }
  @starting-style { .cajon[open]::backdrop { opacity: 0; } }
  .cajon__interior {
    display: flex;
    flex-direction: column;
    gap: var(--e-5);
    min-height: 100%;
    padding: calc(var(--e-3) + env(safe-area-inset-top, 0px)) var(--e-5) calc(var(--e-6) + env(safe-area-inset-bottom, 0px)) max(var(--e-5), env(safe-area-inset-left, 0px));
  }
  .cajon__cabeza { display: flex; align-items: center; justify-content: space-between; }
  .cajon__rotulo { font-size: var(--t-sm); font-weight: var(--peso-boton); }
  .cajon__lista { margin: 0; padding: 0; list-style: none; border-top: var(--borde); }
  .cajon__lista li { border-bottom: var(--borde); }
  .cajon__enlace {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-2) var(--e-4);
    padding: var(--e-4) var(--e-1);
    text-decoration: none;
  }
  .cajon__nombre {
    font-family: var(--f-display);
    font-stretch: var(--ancho-display);
    font-size: 1.625rem;
    font-weight: var(--peso-display);
    line-height: 1;
    text-transform: uppercase;
  }
  .cajon__nota { margin-left: auto; font-size: var(--t-sm); color: var(--texto-suave); }
  .cajon__pie { margin-top: auto; display: grid; gap: var(--e-4); justify-items: start; }
  .cajon__tagline { font-size: var(--t-md); font-weight: var(--peso-boton); }

  .solo-escritorio { display: none; }
  @media (min-width: 1024px) {
    .solo-movil { display: none; }
    .solo-escritorio { display: block; }
    .encabezado__fila { min-height: 84px; transition: min-height var(--medio) var(--suave); }
    .encabezado.compacto .encabezado__fila { min-height: 64px; }
    .encabezado__logo { --alto-logo: 60px; }
    .encabezado.compacto .encabezado__logo { --alto-logo: 44px; }
    .icono--buscar { padding-inline: var(--e-3); }
    .icono__texto { display: inline; font-size: var(--t-sm); font-weight: var(--peso-medio); }
  }
</style>

<script>
  const encabezado = document.querySelector<HTMLElement>('[data-encabezado]');
  const cajon = document.querySelector<HTMLDialogElement>('[data-cajon]');
  const botonBuscar = document.querySelector<HTMLButtonElement>('[data-abrir-busqueda]');
  const panelBusqueda = document.getElementById('panel-busqueda');

  if (encabezado) {
    const alBajar = () => {
      encabezado.classList.toggle('con-sombra', window.scrollY > 8);
      encabezado.classList.toggle('compacto', window.scrollY > 120);
    };
    window.addEventListener('scroll', alBajar, { passive: true });
    alBajar();
  }

  document.querySelector('[data-abrir-menu]')?.addEventListener('click', () => cajon?.showModal());
  document.querySelector('[data-cerrar-menu]')?.addEventListener('click', () => cajon?.close());
  cajon?.addEventListener('click', (e) => { if (e.target === cajon) cajon.close(); });

  botonBuscar?.addEventListener('click', () => {
    if (!panelBusqueda) return;
    const abrir = panelBusqueda.hidden;
    panelBusqueda.hidden = !abrir;
    botonBuscar.setAttribute('aria-expanded', String(abrir));
    if (abrir) panelBusqueda.querySelector('input')?.focus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panelBusqueda && !panelBusqueda.hidden) {
      panelBusqueda.hidden = true;
      botonBuscar?.setAttribute('aria-expanded', 'false');
      botonBuscar?.focus();
    }
  });
</script>
