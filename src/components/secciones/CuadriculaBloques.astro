---
// Cuadrícula de bloques de distintos tamaños: categorías (con foto) y "moods" (bloques de color).
// Se edita en src/data/home.json → cuadricula.
import Foto from '../base/Foto.astro';
import Estrella from '../base/Estrella.astro';
import home from '../../data/home.json';
const { titulo, bloques } = home.cuadricula;
---
<section class="cuadricula seccion" aria-labelledby="cuadricula-titulo">
  <div class="contenedor">
    <h2 class="titulo-seccion cuadricula__titulo" id="cuadricula-titulo">{titulo}</h2>
    <ul class="cuadricula__grilla" role="list">
      {bloques.map((b) => (
        <li class:list={['bloque', `bloque--${b.tipo}`, b.color && `bloque--${b.color}`, b.tipo === 'color' && 'sobre-oscuro']} style={`grid-area:${b.area}`}>
          <a class="bloque__enlace" href={b.enlace}>
            {b.tipo === 'foto' && <Foto src={b.foto} alt="" nota={b.nota} proporcion="llenar" />}
            <span class="bloque__texto">
              {b.tipo === 'color' && <Estrella tamano="1.25rem" clase="bloque__estrella" />}
              <span class="bloque__nombre">{b.titulo}</span>
              {b.frase && <span class="bloque__frase">{b.frase}</span>}
            </span>
            <span class="bloque__flecha" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cuadricula__titulo { margin-bottom: var(--e-5); }
  .cuadricula__grilla {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: clamp(150px, 44vw, 220px);
    grid-template-areas:
      "aretes aretes"
      "collares anillos"
      "collares regalar"
      "pulseras sets"
      "capas capas";
    gap: var(--e-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bloque { min-width: 0; }
  .bloque__enlace {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    overflow: hidden;
    border-radius: var(--r-bloque);
    color: var(--hueso);
    text-decoration: none;
    isolation: isolate;
  }
  .bloque__enlace :global(.foto) { position: absolute; inset: 0; z-index: -2; }
  .bloque__enlace :global(.foto img) { transition: transform 0.8s var(--suave); }
  .bloque__enlace:hover :global(.foto img) { transform: scale(1.04); }
  .bloque__enlace :global(.foto__marcador) { align-items: flex-start; padding-right: 52px; }
  /* velo para que el nombre se lea sobre cualquier foto */
  .bloque--foto .bloque__enlace::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(35 42 68 / 0.75), rgb(35 42 68 / 0) 55%);
  }
  .bloque--noche .bloque__enlace { background: var(--noche); }
  .bloque--profundo .bloque__enlace { background: var(--profundo); }
  .bloque--color .bloque__enlace { justify-content: space-between; }

  .bloque__texto { display: grid; gap: var(--e-1); padding: var(--e-4); }
  .bloque--color .bloque__texto { height: 100%; align-content: space-between; }
  .bloque__texto :global(.bloque__estrella) { color: var(--perla); }
  .bloque__nombre {
    font-family: var(--f-display);
    font-variation-settings: var(--display-ajustes);
    font-weight: var(--peso-display);
    font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .bloque--color .bloque__nombre { font-size: clamp(1.6rem, 1.2rem + 2vw, 2.75rem); }
  .bloque__frase { font-size: var(--t-sm); color: var(--hueso-70); }
  .bloque--color .bloque__texto > span:last-child { align-self: end; }
  .bloque--color .bloque__nombre + .bloque__frase { margin-top: auto; }

  /* En celular la flecha va arriba a la derecha para dejarle todo el ancho al nombre */
  .bloque__flecha {
    position: absolute;
    right: var(--e-3);
    top: var(--e-3);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--r-circulo);
    background: var(--perla);
    color: var(--noche);
    transition: transform var(--medio) var(--suave);
  }
  .bloque__enlace:hover .bloque__flecha { transform: translateX(4px); }
  .bloque__enlace:focus-visible { outline: 2px solid var(--noche); outline-offset: 3px; }

  @media (min-width: 900px) {
    .cuadricula__grilla {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: clamp(220px, 20vw, 280px);
      grid-template-areas:
        "aretes aretes collares anillos"
        "aretes aretes collares regalar"
        "pulseras sets capas capas";
      gap: var(--e-4);
    }
    .bloque__texto { padding: var(--e-5); padding-right: 72px; }
    .bloque__flecha { top: auto; right: var(--e-5); bottom: var(--e-5); width: 48px; height: 48px; }
    .bloque__enlace :global(.foto__marcador) { padding-right: var(--e-3); }
  }
</style>
