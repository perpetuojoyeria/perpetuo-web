---
// Cuadrícula de categorías y "moods" de borde a borde, con fotos pegadas y esquinas rectas.
// Se edita en src/data/home.json → cuadricula.
import Foto from '../base/Foto.astro';
import home from '../../data/home.json';
const { titulo, bloques } = home.cuadricula;
---
<section class="cuadricula" aria-labelledby="cuadricula-titulo">
  <div class="relleno cabeza-seccion">
    <h2 class="titulo-seccion" id="cuadricula-titulo">{titulo}</h2>
  </div>
  <ul class="cuadricula__grilla" role="list">
    {bloques.map((b) => (
      <li class:list={['bloque', `bloque--${b.tipo}`, b.color && `bloque--${b.color}`, (b.color === 'noche' || b.color === 'profundo') && 'sobre-oscuro']} style={`grid-area:${b.area}`}>
        <a class="bloque__enlace" href={b.enlace}>
          {b.tipo === 'foto' && <Foto src={b.foto} alt="" nota={b.nota} proporcion="llenar" />}
          {b.tipo === 'color' ? (
            <span class="bloque__mood">
              <span class="bloque__mood-titulo">{b.titulo}</span>
              {b.frase && <span class="bloque__mood-frase">{b.frase}</span>}
              <span class="bloque__mood-ir">Ver →</span>
            </span>
          ) : (
            <span class="bloque__rotulo">{b.titulo} <span aria-hidden="true">→</span></span>
          )}
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .cuadricula { padding-top: var(--seccion); }
  .cuadricula__grilla {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 50vw;
    grid-template-areas:
      "aretes aretes"
      "aretes aretes"
      "collares anillos"
      "regalar pulseras"
      "sets capas";
    gap: var(--junta);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bloque { min-width: 0; }
  .bloque__enlace {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 100%;
    overflow: hidden;
    text-decoration: none;
    isolation: isolate;
  }
  .bloque__enlace :global(.foto) { position: absolute; inset: 0; z-index: -1; }
  .bloque__enlace :global(.foto img) { transition: transform 0.8s var(--suave); }
  .bloque__enlace:hover :global(.foto img) { transform: scale(1.04); }
  .bloque__enlace :global(.foto__marcador) { align-items: flex-start; padding-bottom: 64px; }
  .bloque__enlace:focus-visible { outline-offset: -4px; }

  /* Rótulo tipo sticker sobre la foto */
  .bloque__rotulo {
    margin: var(--e-3);
    padding: var(--e-2) var(--e-3);
    background: var(--hueso);
    color: var(--noche);
    font-family: var(--f-display);
    font-stretch: var(--ancho-display);
    font-weight: var(--peso-display);
    font-size: clamp(0.95rem, 0.8rem + 0.8vw, 1.5rem);
    line-height: 1;
    text-transform: uppercase;
    transition: background var(--rapido), color var(--rapido);
  }
  .bloque__enlace:hover .bloque__rotulo { background: var(--perla); }

  /* Bloques de color ("moods") */
  .bloque--perla .bloque__enlace { background: var(--perla); color: var(--noche); }
  .bloque--noche .bloque__enlace { background: var(--noche); color: var(--hueso); }
  .bloque--profundo .bloque__enlace { background: var(--profundo); color: var(--hueso); }
  .bloque__mood { display: grid; gap: var(--e-2); align-content: end; width: 100%; height: 100%; padding: var(--e-4); }
  .bloque__mood-titulo {
    font-family: var(--f-display);
    font-stretch: var(--ancho-display);
    font-weight: var(--peso-display);
    font-size: clamp(1.5rem, 1rem + 2.6vw, 3.25rem);
    line-height: 0.9;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .bloque__mood-frase { font-size: var(--t-sm); font-weight: var(--peso-medio); }
  .bloque__mood-ir {
    justify-self: start;
    margin-top: var(--e-2);
    font-size: var(--t-sm);
    font-weight: var(--peso-boton);
    border-bottom: 2px solid currentColor;
  }

  @media (min-width: 900px) {
    .cuadricula__grilla {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: clamp(240px, 24vw, 360px);
      grid-template-areas:
        "aretes aretes collares anillos"
        "aretes aretes regalar pulseras"
        "sets capas capas capas";
    }
    .bloque__rotulo { margin: var(--e-4); padding: var(--e-2) var(--e-4); }
    .bloque__mood { padding: var(--e-6); }
  }
</style>
