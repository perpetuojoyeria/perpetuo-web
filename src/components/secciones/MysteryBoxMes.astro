---
// Mystery Box del mes: gran bloque Amarillo Perla con la foto de borde a borde,
// sello de precio, valor garantizado y selector de metal. Se edita en src/data/mystery-box.json.
import Foto from '../base/Foto.astro';
import SelloPrecio from '../base/SelloPrecio.astro';
import Etiqueta from '../base/Etiqueta.astro';
import { formatoCOP } from '../../lib/precio';
import metales from '../../data/metales.json';
import box from '../../data/mystery-box.json';

type Metal = 'plata' | 'oro' | 'rodio';
const inicial = box.versiones[0];
const datos = Object.fromEntries(box.versiones.map((v) => [v.metal, {
  nombre: v.nombre,
  precio: formatoCOP(v.precio),
  valor: formatoCOP(v.valorGarantizado),
  piezas: `${v.piezas} piezas`,
  enlace: `/mystery-box#${v.metal}`,
}]));
---
<section class="secreto" aria-labelledby="secreto-titulo" data-secreto data-versiones={JSON.stringify(datos)}>
  <div class="secreto__foto">
    <Foto src={box.foto} alt="La mystery box del mes, cerrada" nota={box.nota} proporcion="llenar" />
    <SelloPrecio valor={inicial.precio} texto="por" clase="secreto__sello" />
  </div>

  <div class="secreto__texto">
    <p class="secreto__mes">
      <Etiqueta texto={`Edición de ${box.mes}`} variante="oscura" />
      {box.placeholder && <Etiqueta texto="Ejemplo" variante="suave" />}
    </p>
    <h2 class="secreto__titulo" id="secreto-titulo">{box.titulo}</h2>
    <p class="secreto__frase">{box.frase}</p>

    <fieldset class="secreto__metales">
      <legend class="solo-lector">Elige el metal de tu caja</legend>
      {box.versiones.map((v, i) => (
        <label class="secreto__metal">
          <input type="radio" name="secreto-metal" value={v.metal} checked={i === 0} />
          <span class={`punto punto--${v.metal}`} aria-hidden="true"></span>
          {metales[v.metal as Metal].nombre}
        </label>
      ))}
    </fieldset>

    <dl class="secreto__datos" aria-live="polite">
      <div class="secreto__dato secreto__dato--nombre">
        <dt>Tu caja</dt>
        <dd data-campo="nombre">{inicial.nombre}</dd>
      </div>
      <div class="secreto__dato">
        <dt>Valor garantizado</dt>
        <dd data-campo="valor">{formatoCOP(inicial.valorGarantizado)}</dd>
      </div>
      <div class="secreto__dato">
        <dt>Trae</dt>
        <dd data-campo="piezas">{inicial.piezas} piezas</dd>
      </div>
      <div class="secreto__dato">
        <dt>Pídela</dt>
        <dd>{box.modalidades[0]} o {box.modalidades[1].toLowerCase()}</dd>
      </div>
    </dl>

    <div class="secreto__acciones">
      <a class="boton boton--oscuro" href={`/mystery-box#${inicial.metal}`} data-campo-enlace>Quiero la mía</a>
      <a class="enlace" href="/mystery-box#como-funciona">Cómo funciona</a>
    </div>
  </div>
</section>

<style>
  .secreto {
    display: grid;
    background: var(--perla);
    color: var(--noche);
    border-block: var(--borde-fuerte);
  }
  .secreto__foto { position: relative; aspect-ratio: 1 / 1; max-width: 100%; border-bottom: var(--borde-fuerte); }
  .secreto__foto :global(.foto) { background: var(--profundo); }
  .secreto__foto :global(.foto__marcador) { background: var(--profundo); align-items: flex-start; }
  .secreto__foto :global(.foto__nota) { color: var(--hueso-70); }
  .secreto__foto :global(.secreto__sello) { position: absolute; right: var(--e-4); bottom: var(--e-4); }

  .secreto__texto {
    display: grid;
    gap: var(--e-4);
    justify-items: start;
    align-content: center;
    min-width: 0;
    padding: var(--e-6) var(--margen-der) var(--e-7) var(--margen);
  }
  .secreto__mes { display: flex; flex-wrap: wrap; gap: var(--e-2); }
  .secreto__titulo { font-size: var(--t-2xl); max-width: 9ch; }
  .secreto__frase { font-size: var(--t-md); font-weight: var(--peso-medio); }

  .secreto__metales { display: flex; flex-wrap: wrap; gap: var(--e-2); margin: var(--e-2) 0 0; padding: 0; border: 0; min-width: 0; }
  .secreto__metal {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 44px;
    padding: 0 var(--e-4);
    border: var(--borde-fuerte);
    border-radius: var(--r-pildora);
    background: var(--hueso);
    font-size: var(--t-sm);
    font-weight: var(--peso-boton);
    cursor: pointer;
  }
  .secreto__metal input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .secreto__metal:has(input:checked) { background: var(--noche); color: var(--hueso); }
  .secreto__metal:has(input:focus-visible) { outline: 2px solid var(--noche); outline-offset: 3px; }
  .punto { width: 14px; height: 14px; border-radius: var(--r-circulo); border: 1px solid var(--noche); }
  .secreto__metal:has(input:checked) .punto { border-color: var(--hueso); }
  .punto--oro { background: var(--metal-oro); }
  .punto--plata { background: var(--metal-plata); }
  .punto--rodio { background: var(--metal-rodio); }

  .secreto__datos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
    margin: var(--e-2) 0 0;
    border-top: var(--borde-fuerte);
  }
  .secreto__dato { padding: var(--e-3) var(--e-2) var(--e-3) 0; border-bottom: var(--borde); min-width: 0; }
  .secreto__dato--nombre, .secreto__dato:last-child { grid-column: 1 / -1; }
  .secreto__dato dt { font-size: 0.6875rem; font-weight: var(--peso-boton); letter-spacing: var(--espaciado-etiqueta); text-transform: uppercase; }
  .secreto__dato dd { margin: var(--e-1) 0 0; font-weight: var(--peso-boton); }
  .secreto__dato--nombre dd {
    font-family: var(--f-display);
    font-stretch: var(--ancho-display);
    font-weight: var(--peso-display);
    font-size: var(--t-xl);
    line-height: 1;
    text-transform: uppercase;
  }
  .secreto__acciones { display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-3) var(--e-5); margin-top: var(--e-2); }

  @media (min-width: 900px) {
    .secreto { grid-template-columns: 1fr 1fr; }
    .secreto__datos { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .secreto__dato:last-child { grid-column: auto; }
    .secreto__foto { aspect-ratio: auto; min-height: 640px; border-bottom: 0; border-right: var(--borde-fuerte); }
    .secreto__foto :global(.secreto__sello) { right: var(--e-6); bottom: var(--e-6); transform: rotate(-8deg) scale(1.2); }
    .secreto__texto { padding: var(--e-8) clamp(2rem, 5vw, 5rem); }
  }
</style>

<script>
  // Al elegir otro metal cambian el nombre, el sello de precio, el valor y el enlace.
  document.querySelectorAll<HTMLElement>('[data-secreto]').forEach((seccion) => {
    const versiones = JSON.parse(seccion.dataset.versiones || '{}');
    const campo = (n: string) => seccion.querySelector<HTMLElement>(`[data-campo="${n}"]`);
    const sello = seccion.querySelector<HTMLElement>('.sello__valor');
    const enlace = seccion.querySelector<HTMLAnchorElement>('[data-campo-enlace]');
    seccion.addEventListener('change', (e) => {
      const v = versiones[(e.target as HTMLInputElement).value];
      if (!v) return;
      campo('nombre')!.textContent = v.nombre;
      campo('valor')!.textContent = v.valor;
      campo('piezas')!.textContent = v.piezas;
      if (sello) sello.textContent = v.precio;
      if (enlace) enlace.href = v.enlace;
    });
  });
</script>
