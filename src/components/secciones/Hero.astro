---
// Hero con video de borde a borde y título gigante encima (estilo Studs).
// Textos y nombres del video en src/data/hero.json.
import hero from '../../data/hero.json';
import { existeEnPublic as existe } from '../../lib/archivos';

const { video, anillo } = hero;
const anilloReal = existe(anillo.src);
const anilloSrc = anilloReal ? anillo.src : existe(anillo.prueba) ? anillo.prueba : null;
const hayVideo = existe(video.mp4);
const hayWebm = existe(video.webm);
const hayEscritorio = existe(video.mp4Escritorio);
const hayPosterEscritorio = existe(video.posterEscritorio);
const hayPoster = existe(video.poster);
// Con la foto real, el recorte (qué va delante y detrás de las letras), el tamaño y el giro salen de hero.json
const a = anillo as Record<string, string>;
const estiloAnillo = anilloReal
  ? [a.recorteAdelante && `--recorte-adelante:${a.recorteAdelante}`, a.recorteAtras && `--recorte-atras:${a.recorteAtras}`,
     a.ancho && `--ancho-anillo:${a.ancho}`, a.anchoEscritorio && `--ancho-anillo-escritorio:${a.anchoEscritorio}`,
     a.giro && `--giro-anillo:${a.giro}`].filter(Boolean).join(';')
  : undefined;
---
<section class:list={['hero sobre-oscuro', { 'hero--horizontal': hayEscritorio }]} aria-labelledby="hero-titulo">
  <div class="hero__medio">
    {hayVideo ? (
      <video class="hero__video" muted loop playsinline preload="metadata"
        poster={hayPoster ? video.poster : undefined} aria-label={video.descripcionAccesible} data-hero-video
        data-src-escritorio={hayEscritorio ? video.mp4Escritorio : undefined}
        data-poster-escritorio={hayPosterEscritorio ? video.posterEscritorio : undefined}>
        {hayWebm && <source src={video.webm} type="video/webm" />}
        <source src={video.mp4} type="video/mp4" />
      </video>
    ) : (
      <div class="hero__marcador" role="img" aria-label={video.descripcionAccesible}>
        <span class="hero__nota"><strong>Video:</strong> {hero.marcador}</span>
      </div>
    )}
    {hayVideo && (
      <button class="hero__pausa" type="button" aria-label="Pausar video" data-hero-pausa>
        <svg class="icono-pausa" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect x="2.5" y="1.5" width="3" height="11" rx="1" fill="currentColor"/><rect x="8.5" y="1.5" width="3" height="11" rx="1" fill="currentColor"/></svg>
        <svg class="icono-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3.5 1.8v10.4a.6.6 0 0 0 .9.5l8.2-5.2a.6.6 0 0 0 0-1L4.4 1.3a.6.6 0 0 0-.9.5Z" fill="currentColor"/></svg>
      </button>
    )}
  </div>

  {anilloSrc && !anilloReal && <span class="hero__prueba">Anillo de prueba · cambiar por foto real</span>}
  <div class="hero__texto">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="hero__titulo" id="hero-titulo" data-titulo-anillo style={estiloAnillo}>
      {anilloSrc && <img class="anillo anillo--atras" src={anilloSrc} alt="" aria-hidden="true" fetchpriority="high" />}
      <span class="hero__titulo-texto">{hero.titulo}</span>
      {anilloSrc && <img class="anillo anillo--adelante" src={anilloSrc} alt="" aria-hidden="true" />}
    </h1>
    <p class="hero__frase">{hero.frase}</p>
    <div class="hero__botones">
      <a class="boton" href={hero.botonPrincipal.enlace}>{hero.botonPrincipal.texto}</a>
      <a class="boton boton--borde" href={hero.botonSecundario.enlace}>{hero.botonSecundario.texto}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    background: var(--profundo);
    color: var(--hueso);
    overflow: hidden;
  }
  .hero__medio, .hero__texto { grid-area: 1 / 1; }
  .hero__medio {
    position: relative;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 9 / 16;      /* video vertical, casi a pantalla completa en celular */
    max-height: 84svh;
  }
  .hero__video, .hero__marcador { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .hero__medio::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(35 42 68 / 0.85) 0%, rgb(35 42 68 / 0.35) 40%, transparent 65%);
    pointer-events: none;
  }
  .hero__marcador { display: flex; align-items: flex-start; padding: var(--e-4) var(--margen); background: var(--noche); }
  .hero__nota { max-width: 40ch; font-size: 0.6875rem; line-height: 1.4; color: var(--hueso-70); }

  .hero__pausa {
    position: absolute;
    z-index: 2;
    top: var(--e-3);
    right: var(--margen-der);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--hueso-linea);
    border-radius: var(--r-pildora);
    background: var(--velo);
    color: var(--hueso);
    cursor: pointer;
  }
  .hero__pausa .icono-play { display: none; }
  .hero__pausa[data-pausado] .icono-play { display: block; }
  .hero__pausa[data-pausado] .icono-pausa { display: none; }

  .hero__texto {
    position: relative;
    z-index: 1;
    align-self: end;
    display: grid;
    gap: var(--e-3);
    justify-items: start;
    padding: var(--e-6) var(--margen-der) var(--e-5) var(--margen);
  }
  /* Etiqueta amarilla con letra azul: se lee bien aunque el anillo pase por detrás */
  .hero__eyebrow {
    position: relative;
    z-index: 3;
    padding: var(--e-1) var(--e-2);
    border: 1px solid var(--noche);
    border-radius: var(--r-etiqueta);
    background: var(--perla);
    color: var(--noche);
    font-size: var(--t-xs);
    font-weight: var(--peso-boton);
    letter-spacing: var(--espaciado-etiqueta);
    text-transform: uppercase;
  }
  .hero__titulo { position: relative; isolation: isolate; font-size: var(--t-3xl); max-width: 11ch; }
  .hero__titulo-texto { position: relative; z-index: 1; }

  /* El anillo atraviesa el título: la mitad de atrás va detrás de las letras
     y la mitad de adelante, encima. Es la misma imagen recortada en dos. */
  .anillo {
    --giro: var(--giro-anillo, -11deg);
    position: absolute;
    left: 62%;
    top: 34%;
    width: var(--ancho-anillo, 86%);
    max-width: none;
    height: auto;
    pointer-events: none;
    transform: translate(-50%, -50%) rotate(var(--giro));
    translate: calc(var(--px, 0) * 14px) calc(var(--py, 0) * 10px);
    transition: translate 0.6s var(--suave);
  }
  .anillo--atras { z-index: 0; clip-path: var(--recorte-atras, inset(0 0 50% 0)); }
  .anillo--adelante { z-index: 2; clip-path: var(--recorte-adelante, inset(50% 0 0 0)); filter: drop-shadow(0 14px 16px rgb(35 42 68 / 0.55)); }
  @media (prefers-reduced-motion: no-preference) {
    .anillo { animation: flotar 6s ease-in-out infinite, aparecer 1.1s var(--suave) both; }
  }
  @keyframes flotar {
    0%, 100% { transform: translate(-50%, -50%) rotate(var(--giro)); }
    50% { transform: translate(-50%, calc(-50% - 10px)) rotate(calc(var(--giro) + 3deg)); }
  }
  @keyframes aparecer { from { opacity: 0; scale: 0.85; } }
  .hero__prueba {
    position: absolute;
    z-index: 3;
    bottom: var(--e-2);
    right: calc(var(--margen-der) + 52px);
    font-size: 0.625rem;
    font-weight: var(--peso-boton);
    letter-spacing: var(--espaciado-etiqueta);
    text-transform: uppercase;
    color: var(--hueso-70);
  }
  .hero__frase { font-size: var(--t-md); font-weight: var(--peso-medio); }
  .hero__botones { display: flex; flex-wrap: wrap; gap: var(--e-2); margin-top: var(--e-2); }
  .hero__botones .boton { padding-inline: var(--e-5); }

  @media (prefers-reduced-motion: no-preference) {
    .hero__texto > * { animation: subir 0.8s var(--suave) both; }
    .hero__titulo { animation-delay: 0.06s; }
    .hero__frase { animation-delay: 0.14s; }
    .hero__botones { animation-delay: 0.22s; }
  }
  @keyframes subir { from { opacity: 0.001; transform: translateY(16px); } }

  /* Computador: portada de revista. Texto y anillo a la izquierda sobre Azul Noche,
     el video vertical completo a la derecha (sin recortes ni zoom). */
  @media (min-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr) auto; background: var(--noche); }
    .hero__texto { grid-area: 1 / 1; align-self: center; padding: var(--e-6) var(--e-7); gap: var(--e-4); }
    /* El Hero completo cabe justo en la pantalla: alto de la ventana menos la barra de anuncio y el encabezado */
    .hero__medio { grid-area: 1 / 2; aspect-ratio: 9 / 16; height: max(520px, calc(100svh - var(--alto-arriba, 164px))); width: auto; max-height: none; }
    .hero__medio::after { display: none; }
    .hero__titulo { font-size: clamp(3rem, 1rem + 5.6vw, 7.5rem); }
    .anillo { left: 66%; top: 34%; width: var(--ancho-anillo-escritorio, 50%); --giro: var(--giro-anillo, -12deg); }
    .hero__pausa { top: auto; bottom: var(--e-5); right: var(--e-5); }
    .hero__prueba { bottom: var(--e-5); right: auto; left: var(--e-7); }

    /* Con video horizontal (hero-escritorio.mp4): el video es el fondo completo
       y el título con el anillo van encima, a la izquierda. */
    .hero--horizontal { grid-template-columns: minmax(0, 1fr); background: var(--profundo); }
    .hero--horizontal .hero__medio { grid-area: 1 / 1; width: 100%; aspect-ratio: auto; }
    .hero--horizontal .hero__video { object-position: center 30%; }
    /* velo plano para que el título se lea sobre la camisa clara */
    .hero--horizontal .hero__medio::after { display: block; background: rgb(35 42 68 / 0.38); }
    .hero--horizontal .hero__texto { grid-area: 1 / 1; z-index: 1; padding-left: var(--e-8); }
  }
</style>

<script>
  // Reproduce el video solo si conviene (sin "reducir movimiento" ni ahorro de datos)
  // y lo pausa cuando sale de la pantalla.
  // Mide lo que hay encima del Hero (barra de anuncio + encabezado) para que el Hero quepa justo en la pantalla
  const heroSeccion = document.querySelector<HTMLElement>('.hero');
  const medirArriba = () => {
    if (!heroSeccion) return;
    const arriba = heroSeccion.getBoundingClientRect().top + window.scrollY;
    heroSeccion.style.setProperty('--alto-arriba', `${Math.round(arriba)}px`);
  };
  medirArriba();
  window.addEventListener('resize', medirArriba, { passive: true });

  // El anillo se mueve un poquito siguiendo el mouse (solo en computador)
  const titulo = document.querySelector<HTMLElement>('[data-titulo-anillo]');
  if (titulo && window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    window.addEventListener('pointermove', (e) => {
      titulo.style.setProperty('--px', ((e.clientX / window.innerWidth) * 2 - 1).toFixed(3));
      titulo.style.setProperty('--py', ((e.clientY / window.innerHeight) * 2 - 1).toFixed(3));
    }, { passive: true });
  }

  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const boton = document.querySelector<HTMLButtonElement>('[data-hero-pausa]');
  // En computador se usa la versión horizontal del video (si existe)
  if (video?.dataset.srcEscritorio && window.matchMedia('(min-width: 900px)').matches) {
    if (video.dataset.posterEscritorio) video.poster = video.dataset.posterEscritorio;
    video.src = video.dataset.srcEscritorio;
    video.load();
  }
  if (video && boton) {
    const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ahorro = (navigator as any).connection?.saveData === true;
    let pausadoPorUsuaria = reducir || ahorro;
    const pintar = () => {
      boton.toggleAttribute('data-pausado', video.paused);
      boton.setAttribute('aria-label', video.paused ? 'Reproducir video' : 'Pausar video');
    };
    const reproducir = () => video.play().catch(() => {}).finally(pintar);
    if (!pausadoPorUsuaria) reproducir(); else pintar();
    boton.addEventListener('click', () => {
      if (video.paused) { pausadoPorUsuaria = false; reproducir(); }
      else { pausadoPorUsuaria = true; video.pause(); pintar(); }
    });
    new IntersectionObserver(([e]) => {
      if (pausadoPorUsuaria) return;
      if (e.isIntersecting) reproducir(); else { video.pause(); pintar(); }
    }, { threshold: 0.25 }).observe(video);
  }
</script>
