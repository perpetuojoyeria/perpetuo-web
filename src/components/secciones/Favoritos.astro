---
// Las favoritas: grilla de productos de borde a borde, fotos pegadas (estilo Studs).
import TarjetaProducto from '../base/TarjetaProducto.astro';
import { favoritos } from '../../lib/productos';
import home from '../../data/home.json';
const textos = home.favoritos;
const lista = favoritos().slice(0, 8);
---
<section class="favoritas seccion" aria-labelledby="favoritas-titulo">
  <div class="relleno cabeza-seccion">
    <div>
      <h2 class="titulo-seccion" id="favoritas-titulo">{textos.titulo}</h2>
      <p>{textos.frase}</p>
    </div>
    <a class="enlace" href={textos.enlace}>{textos.textoEnlace}</a>
  </div>
  <ul class="favoritas__grilla" role="list">
    {lista.map((p, i) => <li><TarjetaProducto producto={p} prioridad={i < 2} /></li>)}
  </ul>
</section>

<style>
  .favoritas__grilla {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--junta);
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--linea);           /* las juntas se ven como líneas finas */
    border-block: 1px solid var(--linea);
  }
  .favoritas__grilla > li { min-width: 0; background: var(--hueso); }
  @media (min-width: 900px) {
    .favoritas__grilla { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
