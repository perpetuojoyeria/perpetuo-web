---
// Plantilla de las páginas de la tienda: barra de anuncio, encabezado, contenido, franja que se mueve y footer.
import Base from './Base.astro';
import BarraAnuncio from '../components/layout/BarraAnuncio.astro';
import Encabezado from '../components/layout/Encabezado.astro';
import Pie from '../components/layout/Pie.astro';
import Marquesina from '../components/secciones/Marquesina.astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
  indexar?: boolean;
  marquesina?: boolean;
}
const { marquesina = true, ...seo } = Astro.props;
---
<Base {...seo}>
  <slot name="head" slot="head" />
  <BarraAnuncio />
  <Encabezado />
  <main id="contenido"><slot /></main>
  {marquesina && <Marquesina />}
  <Pie />
</Base>
