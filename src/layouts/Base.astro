---
// Plantilla base de TODAS las páginas: fuentes, tokens y datos para Google y WhatsApp.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jost';
import '../styles/tokens.css';
import '../styles/base.css';
import sitio from '../data/sitio.json';
import AvisoBolsa from '../components/layout/AvisoBolsa.astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;       // foto para compartir por WhatsApp/Instagram (1200 x 630)
  indexar?: boolean;     // false = Google no muestra esta página
}
const {
  titulo,
  descripcion = sitio.descripcion,
  imagen = sitio.imagenCompartir,
  indexar = true,
} = Astro.props;

const tituloCompleto = titulo ? `${titulo} · ${sitio.nombre}` : `${sitio.nombre} · ${sitio.tagline}`;
const urlCanonica = new URL(Astro.url.pathname, Astro.site ?? `https://${sitio.dominio}`).href;
const urlImagen = new URL(imagen, Astro.site ?? `https://${sitio.dominio}`).href;
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FBFBF4" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />
    {!indexar && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/logos/perpetuo-monograma.png" />

    <!-- Vista previa al compartir (WhatsApp, Instagram, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={urlImagen} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
    <AvisoBolsa />
  </body>
</html>
