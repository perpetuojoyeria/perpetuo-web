---
// Plantilla base: carga fuentes y variables globales para TODAS las páginas.
// Fuentes de Google Fonts, pero servidas desde nuestro propio sitio (más rápido y privado).
import '@fontsource/italiana/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
import '@fontsource/caveat/latin-500.css';
import '../styles/global.css';

interface Props { titulo?: string; descripcion?: string }
const {
  titulo = 'Perpetuo Joyería · Brillo que se queda',
  descripcion = 'Joyería en rodio, plata 925 y oro laminado, hecha en Medellín para llevar por capas todos los días.',
} = Astro.props;
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFDCB" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
  </head>
  <body>
    <slot />
  </body>
</html>
